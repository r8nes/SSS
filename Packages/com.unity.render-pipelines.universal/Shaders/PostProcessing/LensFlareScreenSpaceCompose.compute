#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch switch2 webgpu
#pragma target 4.5
#pragma kernel KComposeFeatures
#pragma kernel KBlurFeatures

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

#define GROUP_SIZE_X 16
#define GROUP_SIZE_Y 8

Texture2D<float4> _LensFlareScreenSpaceBloomMipTexture;
Texture2D<float4> _LensFlareScreenSpaceStreakTex;
Texture2D<float4> _LensFlareFeatureTexture;
SamplerState sampler_LinearClamp;
RWTexture2D<float4> _LensFlareOutputTexture;

float4 _LensFlareScreenSpaceBloomMipTexture_TexelSize;
float4 _LensFlareScreenSpaceStreakTex_TexelSize;
float4 _LensFlareFeatureTexture_TexelSize;
float4 _LensFlareScreenSpaceParams1;
float4 _LensFlareScreenSpaceParams2;
float4 _LensFlareScreenSpaceParams3;
float4 _LensFlareScreenSpaceParams4;
float4 _LensFlareScreenSpaceParams5;
float4 _LensFlareScreenSpaceTintColor;
float4 _LensFlareLogicalSize;
int _LensFlareHasStreak;
int _LensFlareFlipY;

#define FlareIntensity          _LensFlareScreenSpaceParams1.x
#define FirstIntensity          _LensFlareScreenSpaceParams1.y
#define SecondaryIntensity      _LensFlareScreenSpaceParams1.z
#define PolarIntensity          _LensFlareScreenSpaceParams1.w
#define VignetteIntensity       _LensFlareScreenSpaceParams2.x
#define StartingPosition        _LensFlareScreenSpaceParams2.y
#define FlareScale              _LensFlareScreenSpaceParams2.z
#define FlareCount              _LensFlareScreenSpaceParams3.x
#define CountDimmer             _LensFlareScreenSpaceParams3.y
#define ChromaIntensity         _LensFlareScreenSpaceParams3.z
#define StreakIntensity         _LensFlareScreenSpaceParams4.x
#define WarpedScaleX            _LensFlareScreenSpaceParams5.y
#define WarpedScaleY            _LensFlareScreenSpaceParams5.z

float2 TextureToScreenUV(float2 uv)
{
    if (_LensFlareFlipY != 0)
        uv.y = 1.0 - uv.y;
    return uv;
}

float2 ScreenToTextureUV(float2 uv)
{
    if (_LensFlareFlipY != 0)
        uv.y = 1.0 - uv.y;
    return uv;
}

float2 ClampBilinear(float2 uv, float2 texelSize)
{
    float2 edge = texelSize * 0.5;
    return clamp(uv, edge, 1.0 - edge);
}

float Map01(float value, float minValue, float maxValue)
{
    return (value - minValue) / max(maxValue - minValue, 1e-6);
}

float2 ScaleScreenUV(float2 uv, float scale, bool invert, bool polar)
{
    if (polar)
    {
        scale = rcp(max(scale, 1e-6));
        uv = float2(WarpedScaleX * (2.0 * scale) * (uv.x - 0.5),
                    WarpedScaleY * (2.0 * scale) * (uv.y - 0.5));

        float radius = sqrt(max(dot(uv, uv), 0.0));
        float radial = Map01(radius, 0.0, 1.4142135623730951);
        float angle = FastAtan2(uv.x, uv.y);
        float angular = 1.0 - Map01(angle, -PI, PI);
        return float2(angular, invert ? 1.0 - radial : radial);
    }

    uv = (uv - 0.5) * rcp(max(scale, 1e-6)) + 0.5;
    return invert ? 1.0 - uv : uv;
}

float3 SampleBloomScreen(float2 screenUV)
{
    float2 uv = ScreenToTextureUV(screenUV);
    return _LensFlareScreenSpaceBloomMipTexture.SampleLevel(
        sampler_LinearClamp,
        ClampBilinear(uv, _LensFlareScreenSpaceBloomMipTexture_TexelSize.xy), 0.0).rgb;
}

float3 SampleStreakScreen(float2 screenUV)
{
    float2 uv = ScreenToTextureUV(screenUV);
    return _LensFlareScreenSpaceStreakTex.SampleLevel(
        sampler_LinearClamp,
        ClampBilinear(uv, _LensFlareScreenSpaceStreakTex_TexelSize.xy), 0.0).rgb;
}

float3 GetFlareTexture(float2 screenUV, float scale, float intensity, bool polar, bool regularFlare)
{
    bool invert = scale < 0.0;
    bool chromatic = ChromaIntensity > 0.0;

    float2 coords = 2.0 * screenUV - 1.0;
    float2 end = screenUV - coords * dot(coords, coords) * ChromaIntensity;
    float2 diff = end - screenUV;

    if (scale != 1.0 || polar)
        screenUV = ScaleScreenUV(screenUV, abs(scale), invert, polar);

    float3 result;
    if (chromatic)
    {
        diff *= 1.0 / 3.0;
        if (regularFlare)
        {
            result.r = SampleBloomScreen(screenUV).r;
            result.g = SampleBloomScreen(screenUV + diff).g;
            result.b = SampleBloomScreen(screenUV + diff * 2.0).b;
        }
        else
        {
            result.r = SampleStreakScreen(screenUV).r;
            result.g = SampleStreakScreen(screenUV + diff).g;
            result.b = SampleStreakScreen(screenUV + diff * 2.0).b;
        }
    }
    else
    {
        result = regularFlare ? SampleBloomScreen(screenUV) : SampleStreakScreen(screenUV);
    }

    return result * _LensFlareScreenSpaceTintColor.rgb * intensity;
}

float4 ComposeFlare(float2 screenUV)
{
    float3 streakFlare = 0.0;
    if (_LensFlareHasStreak != 0 && StreakIntensity > 0.0)
        streakFlare = GetFlareTexture(screenUV, 1.0, StreakIntensity, false, false);

    float2 centered = abs(2.0 * screenUV - 1.0);
    float2 vignetteAxis = saturate(centered * centered);
    float vignetteRound = saturate((vignetteAxis.x + vignetteAxis.y) * (vignetteAxis.x + vignetteAxis.y));
    vignetteRound = lerp(1.0, vignetteRound, VignetteIntensity);

    float3 regularFlare = 0.0;
    if (FlareIntensity > 0.0)
    {
        float3 classic = 0.0;
        float3 classicInv = 0.0;
        float3 polarInv = 0.0;
        float dimmer = 1.0;
        int sampleCount = max((int)FlareCount, 0);

        [loop]
        for (int i = 0; i < sampleCount; ++i)
        {
            float scale = pow(max(abs((float)i + StartingPosition), 1e-6), FlareScale);
            if (SecondaryIntensity > 0.0)
                classic += GetFlareTexture(screenUV, -scale, SecondaryIntensity * 0.1 * dimmer, false, true);
            if (FirstIntensity > 0.0)
                classicInv += GetFlareTexture(screenUV, scale, FirstIntensity * 0.1 * dimmer, false, true);
            if (PolarIntensity > 0.0)
                polarInv += GetFlareTexture(screenUV, -scale, PolarIntensity * 0.1 * dimmer, true, true);
            dimmer *= CountDimmer;
        }

        regularFlare += (classicInv + classic) * vignetteRound;
        regularFlare += polarInv * vignetteAxis.x;
    }

    return float4(regularFlare + streakFlare, 1.0) * FlareIntensity;
}

float3 SampleFeature(float2 uv)
{
    float2 edge = _LensFlareFeatureTexture_TexelSize.xy * 0.5;
    uv = clamp(uv, edge, 1.0 - edge);
    return _LensFlareFeatureTexture.SampleLevel(sampler_LinearClamp, uv, 0.0).rgb;
}

// Exact separable 5x5 binomial Gaussian [1 4 6 4 1]^2 / 256, collapsed
// into 3x3 hardware-bilinear taps. The +/-1.2 positions reconstruct the
// [-2,-1] and [1,2] texel pairs exactly, so this is not a fitted blur kernel.
float3 BlurFeatureGaussian5x5(float2 uv)
{
    float2 texel = _LensFlareFeatureTexture_TexelSize.xy;
    float2 o = texel * 1.2;

    const float wOuter = 5.0 / 16.0;
    const float wCenter = 6.0 / 16.0;

    float3 result = 0.0;
    result += SampleFeature(uv + float2(-o.x, -o.y)) * (wOuter * wOuter);
    result += SampleFeature(uv + float2( 0.0, -o.y)) * (wCenter * wOuter);
    result += SampleFeature(uv + float2( o.x, -o.y)) * (wOuter * wOuter);

    result += SampleFeature(uv + float2(-o.x,  0.0)) * (wOuter * wCenter);
    result += SampleFeature(uv)                         * (wCenter * wCenter);
    result += SampleFeature(uv + float2( o.x,  0.0)) * (wOuter * wCenter);

    result += SampleFeature(uv + float2(-o.x,  o.y)) * (wOuter * wOuter);
    result += SampleFeature(uv + float2( 0.0,  o.y)) * (wCenter * wOuter);
    result += SampleFeature(uv + float2( o.x,  o.y)) * (wOuter * wOuter);
    return result;
}

[numthreads(GROUP_SIZE_X, GROUP_SIZE_Y, 1)]
void KComposeFeatures(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 size = max(uint2(_LensFlareLogicalSize.xy), uint2(1, 1));
    uint2 pixel = dispatchThreadId.xy;
    if (any(pixel >= size))
        return;

    float2 textureUV = (float2(pixel) + 0.5) * _LensFlareLogicalSize.zw;
    float2 screenUV = TextureToScreenUV(textureUV);
    _LensFlareOutputTexture[pixel] = ComposeFlare(screenUV);
}

[numthreads(GROUP_SIZE_X, GROUP_SIZE_Y, 1)]
void KBlurFeatures(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 size = max(uint2(_LensFlareLogicalSize.xy), uint2(1, 1));
    uint2 pixel = dispatchThreadId.xy;
    if (any(pixel >= size))
        return;

    float2 uv = (float2(pixel) + 0.5) * _LensFlareLogicalSize.zw;
    _LensFlareOutputTexture[pixel] = float4(BlurFeatureGaussian5x5(uv), 1.0);
}
