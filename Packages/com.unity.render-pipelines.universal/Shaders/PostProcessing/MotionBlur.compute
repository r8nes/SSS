#pragma target 4.5
#pragma kernel KCameraLow
#pragma kernel KCameraMedium
#pragma kernel KCameraHigh
#pragma kernel KObjectLow
#pragma kernel KObjectMedium
#pragma kernel KObjectHigh

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Random.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/DeclareDepthTexture.hlsl"

// 8x8 keeps the velocity decision local enough to avoid over-sampling a large 16x16
// region because of one fast pixel, while mapping to 64-lane workgroups efficiently.
#define MOTION_BLUR_GROUP_SIZE_X 16
#define MOTION_BLUR_GROUP_SIZE_Y 8
#define MOTION_BLUR_SUBTILE_SIZE 8
#define MOTION_BLUR_GROUP_THREADS 128

TEXTURE2D_X(_InputTexture);
TEXTURE2D_X(_MotionVectorTexture);
TEXTURE2D_X_FLOAT(_OverlayMotionBlurExclusionDepthTexture);
RWTexture2D<float4> _OutputTexture;

float4 _SourceSize; // xy: active output viewport dimensions, zw: reciprocal dimensions
float4 _InputUVParams;        // xy: RTHandle scale, zw: allocated texture texel size
float4 _MotionVectorUVParams; // xy: RTHandle scale, zw: allocated texture texel size
float4 _DepthUVParams;        // xy: RTHandle scale, zw: allocated texture texel size
float4 _OverlayMotionBlurExclusionDepthUVParams;
float _Intensity;
float _Clamp;
int _AlphaOutput;
int _OverlayMotionBlurExclusionEnabled;
float4x4 _MotionBlurPrevReprojection;
float4x4 _MotionBlurCurrentReprojection;

// Positive IEEE-754 floats preserve ordering as uints. Camera-only motion is spatially
// smooth enough to use a per-pixel adaptive count without any workgroup synchronization.
// Object motion keeps an 8x8 coherent count; two subtiles share one 16x8 dispatch group.
groupshared uint s_SubTileMaxBits[2];



float2 ScaleAndClampRTHandleUV(float2 uv, float4 uvParams)
{
    float2 minUV = 0.5 * uvParams.zw;
    float2 maxUV = max(minUV, uvParams.xy - 0.5 * uvParams.zw);
    return clamp(uv * uvParams.xy, minUV, maxUV);
}

bool IsOverlayExcludedFromMotionBlur(float2 uv)
{
    bool excluded = false;
    if (_OverlayMotionBlurExclusionEnabled != 0)
    {
        float2 depthUV = ScaleAndClampRTHandleUV(
            UnityStereoTransformScreenSpaceTex(uv),
            _OverlayMotionBlurExclusionDepthUVParams);
        float rawDepth = SAMPLE_TEXTURE2D_X_LOD(
            _OverlayMotionBlurExclusionDepthTexture,
            sampler_PointClamp,
            depthUV,
            0.0).r;

#if UNITY_REVERSED_Z
        excluded = rawDepth > 0.00001;
#else
        excluded = rawDepth < 0.99999;
#endif
    }
    return excluded;
}

bool IsFiniteVelocity(float2 velocity)
{
    return IsFinite(velocity.x) && IsFinite(velocity.y);
}

float2 ClampVelocity(float2 velocity, float maxVelocity)
{
    float lengthSq = dot(velocity, velocity);
    float maxLengthSq = maxVelocity * maxVelocity;

    [branch]
    if (lengthSq > maxLengthSq && lengthSq > 0.0)
        velocity *= maxVelocity * rsqrt(lengthSq);

    return velocity;
}

half2 GetObjectVelocity(float2 uv)
{
    // Motion vectors remain in normalized screen UV units regardless of the selected
    // AA/upscaler output resolution. Only the texture address needs RTHandle scaling.
    float2 motionUV = ScaleAndClampRTHandleUV(uv, _MotionVectorUVParams);
    return -(half2)SAMPLE_TEXTURE2D_X_LOD(_MotionVectorTexture, sampler_LinearClamp, motionUV, 0.0).xy;
}

float SampleSceneDepthCompute(float2 uv)
{
    float2 depthUV = ScaleAndClampRTHandleUV(
        UnityStereoTransformScreenSpaceTex(uv), _DepthUVParams);
    return SAMPLE_TEXTURE2D_X_LOD(_CameraDepthTexture, sampler_PointClamp, depthUV, 0.0).r;
}

half2 GetCameraVelocity(float2 uv)
{
#if UNITY_REVERSED_Z
    float depth = SampleSceneDepthCompute(uv);
#else
    float depth = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, SampleSceneDepthCompute(uv));
#endif

    // Reprojection matrices are pre-composed on the CPU as
    // nonJitteredVP * inverse(jitteredVP). This removes the per-pixel world-space
    // reconstruction matrix multiply and homogeneous world divide.
    float4 clipPos = ComputeClipSpacePosition(uv, depth);
    float4 prevClipPos = mul(_MotionBlurPrevReprojection, clipPos);
    float4 curClipPos = mul(_MotionBlurCurrentReprojection, clipPos);

    float2 prevPosCS = prevClipPos.xy * rcp(prevClipPos.w);
    float2 curPosCS = curClipPos.xy * rcp(curClipPos.w);
    float2 velocity = (prevPosCS - curPosCS) * 0.5;
#if UNITY_UV_STARTS_AT_TOP
    velocity.y = -velocity.y;
#endif
    return (half2)ClampVelocity(velocity, _Clamp);
}

void GatherSample(
    uint sampleNumber,
    half2 velocity,
    half invSampleCount,
    float2 centerUV,
    half randomVal,
    half velocitySign,
    out half4 color,
    out half weight)
{
    half offsetLength = ((half)sampleNumber + 0.5h) + velocitySign * (randomVal - 0.5h);
    float2 sampleUV = centerUV + (float2)((offsetLength * invSampleCount) * velocity * velocitySign);
    weight = IsOverlayExcludedFromMotionBlur(sampleUV) ? 0.0h : 1.0h;
    float2 inputUV = ScaleAndClampRTHandleUV(sampleUV, _InputUVParams);
    color = (half4)SAMPLE_TEXTURE2D_X_LOD(_InputTexture, sampler_PointClamp, inputUV, 0.0);
}

uint ReduceObjectSubTileMax(uint3 groupThreadId, uint groupIndex, uint velocitySqBits)
{
    uint subTile = groupThreadId.x / MOTION_BLUR_SUBTILE_SIZE;

    if (groupIndex < 2u)
        s_SubTileMaxBits[groupIndex] = 0u;

    GroupMemoryBarrierWithGroupSync();
    InterlockedMax(s_SubTileMaxBits[subTile], velocitySqBits);
    GroupMemoryBarrierWithGroupSync();

    return s_SubTileMaxBits[subTile];
}


uint ComputeCoherentSampleCountFromSq(float maxVelocitySqPixels, uint maxSampleCount)
{
    // Equivalent to ceil(length * 2), rounded up to an even count, but comparisons are
    // squared so the expensive sqrt is removed from every pixel. The selected quality
    // setting remains the hard upper bound.
    uint requiredSamples = 0u;
    if (maxVelocitySqPixels >= 0.25)
    {
        requiredSamples = 2u;
        if (maxVelocitySqPixels > 1.0) requiredSamples = 4u;
        if (maxVelocitySqPixels > 4.0) requiredSamples = 6u;
        if (maxVelocitySqPixels > 9.0) requiredSamples = 8u;
    }
    return min(requiredSamples, maxSampleCount);
}

void MotionBlurKernel(uint3 dispatchThreadId, uint3 groupThreadId, uint groupIndex, uint maxIterations, bool useObjectMotion)
{
    uint2 pixel = dispatchThreadId.xy;
    uint2 outputSize = max(uint2(_SourceSize.xy), uint2(1, 1));
    bool validPixel = all(pixel < outputSize);

    float2 uv = (float2(pixel) + 0.5) * _SourceSize.zw;
    half2 velocity = 0.0h;
    float velocitySqPixels = 0.0;
    bool excludeFromMotionBlur = validPixel && IsOverlayExcludedFromMotionBlur(uv);

    if (validPixel && !excludeFromMotionBlur)
    {
        velocity = (useObjectMotion ? GetObjectVelocity(uv) : GetCameraVelocity(uv)) * (half)_Intensity;
        if (!IsFiniteVelocity((float2)velocity))
            velocity = 0.0h;

        float2 velocityPixels = (float2)velocity * _SourceSize.xy;
        velocitySqPixels = dot(velocityPixels, velocityPixels);
    }

    uint sampleCount;
    if (useObjectMotion)
    {
        uint maxVelocitySqBits = ReduceObjectSubTileMax(
            groupThreadId, groupIndex, validPixel ? asuint(velocitySqPixels) : 0u);
        sampleCount = ComputeCoherentSampleCountFromSq(asfloat(maxVelocitySqBits), maxIterations * 2u);
    }
    else
    {
        // Camera velocity varies smoothly over neighboring pixels. Avoiding LDS reduction and
        // barriers costs nothing in image quality: only the number of samples used for this
        // pixel changes, while the shutter interval and sample locations remain unchanged.
        sampleCount = ComputeCoherentSampleCountFromSq(velocitySqPixels, maxIterations * 2u);
    }

    if (!validPixel)
        return;

    // Exact identity for sub-pixel motion. The workgroup-wide count only chooses the
    // coherent loop length of pixels that actually blur.
    [branch]
    if (excludeFromMotionBlur || velocitySqPixels < 0.25 || sampleCount == 0u)
    {
        float2 sourceUV = ScaleAndClampRTHandleUV(uv, _InputUVParams);
        half4 sourceColor = (half4)SAMPLE_TEXTURE2D_X_LOD(_InputTexture, sampler_LinearClamp, sourceUV, 0.0);
        _OutputTexture[pixel] = _AlphaOutput != 0 ? (float4)sourceColor : float4((float3)sourceColor.xyz, 1.0);
        return;
    }

    half randomVal = (half)InterleavedGradientNoise(float2(pixel) + 0.5, 0);
    half invSampleCount = rcp((half)sampleCount);
    uint activeIterations = sampleCount >> 1u;
    half4 color = 0.0h;
    half weight = 0.0h;
    half4 sampleColor;
    half sampleWeight;

    // Object-motion sampleCount is coherent within each 8x8 subtile. Camera-only motion
    // uses the local adaptive count and relies on the natural spatial coherence of camera velocity.
    GatherSample(0u, velocity, invSampleCount, uv, randomVal, -1.0h, sampleColor, sampleWeight);
    color += sampleColor * sampleWeight;
    weight += sampleWeight;
    GatherSample(0u, velocity, invSampleCount, uv, randomVal, 1.0h, sampleColor, sampleWeight);
    color += sampleColor * sampleWeight;
    weight += sampleWeight;

    [branch]
    if (activeIterations > 1u)
    {
        GatherSample(1u, velocity, invSampleCount, uv, randomVal, -1.0h, sampleColor, sampleWeight);
        color += sampleColor * sampleWeight;
        weight += sampleWeight;
        GatherSample(1u, velocity, invSampleCount, uv, randomVal, 1.0h, sampleColor, sampleWeight);
        color += sampleColor * sampleWeight;
        weight += sampleWeight;
    }

    [branch]
    if (activeIterations > 2u)
    {
        GatherSample(2u, velocity, invSampleCount, uv, randomVal, -1.0h, sampleColor, sampleWeight);
        color += sampleColor * sampleWeight;
        weight += sampleWeight;
        GatherSample(2u, velocity, invSampleCount, uv, randomVal, 1.0h, sampleColor, sampleWeight);
        color += sampleColor * sampleWeight;
        weight += sampleWeight;
    }

    [branch]
    if (activeIterations > 3u)
    {
        GatherSample(3u, velocity, invSampleCount, uv, randomVal, -1.0h, sampleColor, sampleWeight);
        color += sampleColor * sampleWeight;
        weight += sampleWeight;
        GatherSample(3u, velocity, invSampleCount, uv, randomVal, 1.0h, sampleColor, sampleWeight);
        color += sampleColor * sampleWeight;
        weight += sampleWeight;
    }

    float2 centerSourceUV = ScaleAndClampRTHandleUV(uv, _InputUVParams);
    half4 centerColor = (half4)SAMPLE_TEXTURE2D_X_LOD(_InputTexture, sampler_LinearClamp, centerSourceUV, 0.0);
    half4 result = weight > 0.0h ? color * rcp(weight) : centerColor;
    if (_AlphaOutput == 0)
        result.w = 1.0h;
    _OutputTexture[pixel] = (float4)result;
}

[numthreads(MOTION_BLUR_GROUP_SIZE_X, MOTION_BLUR_GROUP_SIZE_Y, 1)]
void KCameraLow(uint3 dispatchThreadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
    MotionBlurKernel(dispatchThreadId, groupThreadId, groupIndex, 2u, false);
}

[numthreads(MOTION_BLUR_GROUP_SIZE_X, MOTION_BLUR_GROUP_SIZE_Y, 1)]
void KCameraMedium(uint3 dispatchThreadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
    MotionBlurKernel(dispatchThreadId, groupThreadId, groupIndex, 3u, false);
}

[numthreads(MOTION_BLUR_GROUP_SIZE_X, MOTION_BLUR_GROUP_SIZE_Y, 1)]
void KCameraHigh(uint3 dispatchThreadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
    MotionBlurKernel(dispatchThreadId, groupThreadId, groupIndex, 4u, false);
}

[numthreads(MOTION_BLUR_GROUP_SIZE_X, MOTION_BLUR_GROUP_SIZE_Y, 1)]
void KObjectLow(uint3 dispatchThreadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
    MotionBlurKernel(dispatchThreadId, groupThreadId, groupIndex, 2u, true);
}

[numthreads(MOTION_BLUR_GROUP_SIZE_X, MOTION_BLUR_GROUP_SIZE_Y, 1)]
void KObjectMedium(uint3 dispatchThreadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
    MotionBlurKernel(dispatchThreadId, groupThreadId, groupIndex, 3u, true);
}

[numthreads(MOTION_BLUR_GROUP_SIZE_X, MOTION_BLUR_GROUP_SIZE_Y, 1)]
void KObjectHigh(uint3 dispatchThreadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
    MotionBlurKernel(dispatchThreadId, groupThreadId, groupIndex, 4u, true);
}
