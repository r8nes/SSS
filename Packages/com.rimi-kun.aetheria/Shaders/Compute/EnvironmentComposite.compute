#pragma kernel Composite COMPOSITE_KERNEL=Composite
#pragma kernel CompositeClouds COMPOSITE_KERNEL=CompositeClouds ENVIRONMENT_CLOUDS
#pragma kernel CompositeCloudLayer COMPOSITE_KERNEL=CompositeCloudLayer ENVIRONMENT_CLOUD_LAYER
#pragma kernel CompositeCloudsCloudLayer COMPOSITE_KERNEL=CompositeCloudsCloudLayer ENVIRONMENT_CLOUDS ENVIRONMENT_CLOUD_LAYER
#pragma kernel CompositeHDRI COMPOSITE_KERNEL=CompositeHDRI ENVIRONMENT_HDRI
#pragma kernel CompositeHDRIClouds COMPOSITE_KERNEL=CompositeHDRIClouds ENVIRONMENT_HDRI ENVIRONMENT_CLOUDS
#pragma kernel CompositeHDRICloudLayer COMPOSITE_KERNEL=CompositeHDRICloudLayer ENVIRONMENT_HDRI ENVIRONMENT_CLOUD_LAYER
#pragma kernel CompositeHDRICloudsCloudLayer COMPOSITE_KERNEL=CompositeHDRICloudsCloudLayer ENVIRONMENT_HDRI ENVIRONMENT_CLOUDS ENVIRONMENT_CLOUD_LAYER

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "../../Runtime/Data/ShaderConfigs/AtmosphereShaderConfig.cs.hlsl"
#include "../../ShaderLibrary/Atmosphere/AtmosphereScattering.hlsl"
#include "../../ShaderLibrary/Common/EnvironmentCubemap.hlsl"
#include "../../ShaderLibrary/CloudLayer/CloudLayerCommon.hlsl"
#include "../../ShaderLibrary/Sky/HDRISkyCommon.hlsl"


Texture2DArray _ResolvedClouds;
Texture2DArray _ResolvedCloudDepth;
RWTexture2DArray<float3> _Output;

int _OutputResolution;
float _IncludeSunInBaking;

struct EnvironmentCloudAtmosphere
{
    float3 transmittance;
    float3 additiveRadiance;
};

float3 SampleAtmosphereTransmittanceToBoundary(float3 position, float3 direction)
{
    float height = length(position);
    float3 up = position / max(height, 1e-6f);
    float zenithCos = dot(direction, up);
    float2 uv = 0.0f;
    LutTransmittanceParamsToUv(height, zenithCos, uv);
    return SAMPLE_TEXTURE2D_LOD(
        ATMOSPHERE_TRANSMITTANCE_LUT,
        ATMOSPHERE_TRANSMITTANCE_LUT_SAMPLER,
        uv,
        0.0f).rgb;
}

EnvironmentCloudAtmosphere EvaluateEnvironmentCloudAtmosphere(
    float3 direction,
    float cloudDistanceMeters)
{
    EnvironmentCloudAtmosphere result;
    result.transmittance = 1.0f;
    result.additiveRadiance = 0.0f;

    if (cloudDistanceMeters > 0.0f)
    {
        float viewHeight;
        float3 upVector;
        float3 viewPos;
        float3 spaceOuterRadiance;
        ResolveAtmosphereViewContext(
            direction, viewHeight, upVector, viewPos, spaceOuterRadiance);

        if (viewHeight < _TopRadius)
        {
            float cloudDistance = cloudDistanceMeters / _DistanceUnitMeter;
            float3 cloudPosition = viewPos + direction * cloudDistance;
            float cloudHeight = length(cloudPosition);
            if (cloudHeight > _BottomRadius && cloudHeight < _TopRadius)
            {
                float3 transmittanceToBoundary =
                    SampleAtmosphereTransmittanceToBoundary(viewPos, direction);
                float3 transmittanceFromCloudToBoundary =
                    SampleAtmosphereTransmittanceToBoundary(cloudPosition, direction);
                result.transmittance = saturate(
                    transmittanceToBoundary / max(transmittanceFromCloudToBoundary, 1e-5f));

                float viewZenithCosAngle = 1.0f;
                float lightViewCosAngle = 0.0f;
                GetViewDirectionLutParams(
                    direction, upVector, viewZenithCosAngle, lightViewCosAngle);

                float groundDistance = -1.0f;
                bool intersectsGround = ResolveGroundIntersection(
                    viewPos, direction, groundDistance);
                float2 skyUv = 0.0f;
                SkyViewLutParamsToUv(
                    intersectsGround,
                    viewZenithCosAngle,
                    lightViewCosAngle,
                    viewHeight,
                    skyUv);

                float3 fullPathRadiance = SAMPLE_TEXTURE2D_LOD(
                    ATMOSPHERE_SKY_VIEW_LUT,
                    ATMOSPHERE_SKY_VIEW_LUT_SAMPLER,
                    skyUv,
                    0.0f).rgb * _IntensityMultiplier;

                float3 fullPathOpacity = max(1.0f - transmittanceToBoundary, 1e-5f);
                float3 segmentOpacity = saturate(1.0f - result.transmittance);
                float3 segmentFraction = saturate(segmentOpacity / fullPathOpacity);
                result.additiveRadiance = fullPathRadiance * segmentFraction;
            }
        }
    }

    return result;
}

float SampleCloudWeightedDistance(Texture2DArray textureValue, float3 direction)
{
    return textureValue.SampleLevel(
        sampler_LinearClamp,
        DirectionToCubeCoordinates(direction),
        0.0f).r;
}

float4 SampleCloudField(Texture2DArray textureValue, float3 direction)
{
    return textureValue.SampleLevel(
        sampler_LinearClamp,
        DirectionToCubeCoordinates(direction),
        0.0);
}

float3 CompositeCurrent(float3 direction)
{
#if defined(ENVIRONMENT_HDRI)
    float3 background = SampleHDRISky(direction);
#else
    float3 excludedDiffuseRadiance;
    float3 background = RenderSkyForEnvironment(
        direction,
        excludedDiffuseRadiance,
        _IncludeSunInBaking > 0.5f,
        0.0f);
#endif

#if defined(ENVIRONMENT_CLOUD_LAYER)
    float cloudDistanceMeters = 0.0f;
    float4 cloudLayer = RenderCloudLayerRaw(direction, cloudDistanceMeters);
    float layerOpacity = saturate(cloudLayer.a);
    float layerTransmittance = 1.0f - layerOpacity;
    EnvironmentCloudAtmosphere atmosphereAtLayer =
        EvaluateEnvironmentCloudAtmosphere(direction, cloudDistanceMeters);
    float3 layerRadiance =
        cloudLayer.rgb * atmosphereAtLayer.transmittance +
        atmosphereAtLayer.additiveRadiance * layerOpacity;
    background = layerRadiance + background * layerTransmittance;
#endif

#if defined(ENVIRONMENT_CLOUDS)
    float4 clouds = SampleCloudField(_ResolvedClouds, direction);
    float cloudTransmittance = saturate(clouds.a);
    float cloudOpacity = 1.0f - cloudTransmittance;
    float weightedCloudDistance =
        SampleCloudWeightedDistance(_ResolvedCloudDepth, direction);
    float cloudDistance = cloudOpacity > 1e-4f
        ? weightedCloudDistance / cloudOpacity
        : 0.0f;

    EnvironmentCloudAtmosphere atmosphereAtCloud =
        EvaluateEnvironmentCloudAtmosphere(direction, cloudDistance);
    float3 cloudRadiance =
        clouds.rgb * atmosphereAtCloud.transmittance +
        atmosphereAtCloud.additiveRadiance * cloudOpacity;
    background = cloudRadiance + background * cloudTransmittance;
#endif

#if !defined(ENVIRONMENT_HDRI)
    float viewHeight;
    float3 upVector;
    float3 viewPosition;
    float3 spaceOuterRadiance;
    ResolveAtmosphereViewContext(
        direction,
        viewHeight,
        upVector,
        viewPosition,
        spaceOuterRadiance);
    background = lerp(
        background,
        ApplyArtisticSky(background, direction, upVector),
        _SkyArtisticAffectEnvironment);
#endif

    return max(background, 0.0);
}

[numthreads(8, 8, 1)]
void COMPOSITE_KERNEL(uint3 coord : SV_DispatchThreadID)
{
    if (coord.z >= 6u)
        return;

    uint outputSize = (uint)_OutputResolution;
    if (any(coord.xy >= outputSize))
        return;

    float3 direction = CubeFaceTexelDirection(coord.z, coord.xy, outputSize);
    // Canonical environment radiance conversion: limit the RGB peak to PI,
    // preserving channel ratios before mip generation and lighting integration.
    float3 radiance = CompositeCurrent(direction);
    float peak = Max3(radiance.r, radiance.g, radiance.b);
    _Output[coord] = radiance * min(1.0, PI / max(peak, 1e-6));
}
